# Local development values. `npx supabase@2.122.0 status` prints the publishable key.
# NEXT_PUBLIC_* values are sent to the browser: never put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_INFERENCE_API_URL=http://localhost:8000
# Cloudflare Turnstile site key (public). Set in production, where Supabase Auth
# requires CAPTCHA; leave empty locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
