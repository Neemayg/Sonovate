# Local development values. `npx supabase@2.122.0 status` prints the keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Required when model bundles are configured (to write results and thresholds).
# Server-side only; never put this in the frontend.
SUPABASE_SECRET_KEY=
# Directory holding the model bundles (git-ignored, from the ML export).
# Only bundles pinned in app/bundle.py load from it. Leave unset for no models.
SONOVATE_BUNDLES_DIR=
CORS_ORIGINS=http://localhost:3000
